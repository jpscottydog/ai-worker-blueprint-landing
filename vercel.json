{
  "version": 2,
  "name": "ai-worker-blueprint-landing",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/signup",
      "dest": "/api/signup.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
